{
  "name": "gesture-reader",
  "productName": "Gesture Reader",
  "version": "1.0.2",
  "private": true,
  "main": "electron/main.cjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "assets:sync": "node scripts/sync-runtime-assets.mjs",
    "predev": "npm run assets:sync",
    "dev": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext dev",
    "prebuild": "npm run assets:sync",
    "build": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext build",
    "start": "WRANGLER_LOG_PATH=.wrangler/wrangler.log vinext start",
    "test": "npm run test:unit && npm run build && node --test tests/rendered-html.test.mjs && npm run test:e2e && npm run test:electron",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "test:electron": "npm run electron:renderer && playwright test --config playwright.electron.config.ts",
    "electron:renderer": "node scripts/build-electron-renderer.mjs",
    "electron:dev": "npm run electron:renderer && electron .",
    "electron:package": "npm run electron:renderer && electron-forge make",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "next": "16.2.11",
    "pdfjs-dist": "5.5.207",
    "pdfjs-viewer-element": "3.2.2",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@electron-forge/cli": "7.11.2",
    "@electron-forge/maker-dmg": "7.11.2",
    "@electron-forge/maker-zip": "7.11.2",
    "@playwright/test": "1.61.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "electron": "43.2.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "fake-indexeddb": "^6.2.4",
    "pdf-lib": "^1.17.1",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "vitest": "3.2.4",
    "wrangler": "4.92.0"
  },
  "overrides": {
    "next": {
      "postcss": "8.5.22",
      "sharp": "0.35.3"
    }
  },
  "type": "module"
}
